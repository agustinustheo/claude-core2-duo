#!/usr/bin/env bash
# Optional Linux launcher: isolate Claude from its caller's CPU cgroup.
set -euo pipefail
root=$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")
# The updater already checks the selected release through the real emulator.
# T3's four-second version probe must not pay the emulation startup cost.
if [[ $# -eq 1 && "$1" == "--version" ]]; then
  version=$(cat "$root/current")
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid current version.' >&2; exit 1; }
  [[ -x "$root/downloads/claude-$version" && -x "$root/tools/qemu/usr/bin/qemu-x86_64" ]] || { echo 'Incomplete installation.' >&2; exit 1; }
  printf '%s (Claude Code)\n' "$version"
  exit 0
fi
profile_args=()
# This optional local file selects a profile for future processes only.
if [[ -f "$root/tools/startup-profile" ]]; then
  profile=$(cat "$root/tools/startup-profile")
  case "$profile" in
    full|'') ;;
    fast)
      case "${1:-}" in
        update|upgrade|install|--help|-h) ;;
        *)
          export ENABLE_CLAUDEAI_MCP_SERVERS=false
          export CLAUDE_CODE_SKIP_PLUGIN_MCP_SERVERS=1
          profile_args=(--strict-mcp-config)
          ;;
      esac
      ;;
    *) echo 'Invalid startup profile. Use fast or full.' >&2; exit 1 ;;
  esac
fi
exec /usr/bin/systemd-run --user --scope --quiet --collect \
  --slice=claude.slice "$root/claude" "${profile_args[@]}" "$@"
