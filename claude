#!/usr/bin/env bash
set -euo pipefail
root=$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")
if [[ ! -x "$root/tools/qemu/usr/bin/qemu-x86_64" ]]; then
  echo "Missing QEMU. Run: bash $root/setup.sh" >&2
  exit 1
fi
case "${1:-}" in
  update|upgrade|install)
    shift
    exec python3 "$root/update.py" "$@"
    ;;
esac
if [[ ! -f "$root/current" ]]; then
  echo "Run $root/update.py latest first." >&2
  exit 1
fi
version=$(cat "$root/current")
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Invalid current version.' >&2; exit 1; }
[[ -x "$root/downloads/claude-$version" ]] || { echo "Missing Claude $version. Run: $root/claude update $version" >&2; exit 1; }
# Upstream updates bypass emulation. Updates go through update.py instead.
export DISABLE_AUTOUPDATER=1
# Embedded rg respawns the native executable without QEMU. Use host rg.
export USE_BUILTIN_RIPGREP=0
# QEMU must emulate DFG compilation and then translate its output. Set 1 to restore it.
export BUN_JSC_useDFGJIT="${BUN_JSC_useDFGJIT:-0}"
# Periodic GC passes are expensive under emulation. Memory pressure still starts GC.
export BUN_GC_TIMER_INTERVAL="${BUN_GC_TIMER_INTERVAL:-30000}"
export PATH="$root/tools/ripgrep/usr/bin:$PATH"
command -v rg >/dev/null || { echo "Missing ripgrep. Run: bash $root/setup.sh (or sudo apt install ripgrep)." >&2; exit 1; }
# Bash tool grep and find functions start CLAUDE_CODE_EXECPATH as ugrep or bfs.
# claude-shell points that path here. Claude splits the prefix at " -".
if [[ -z "${CLAUDE_CODE_SHELL_PREFIX:-}" && "$root" != *" -"* ]]; then
  export CLAUDE_CODE_SHELL_PREFIX="$root/claude-shell"
fi
# A script does not receive argv[0], so match the fixed leading arguments.
tool=()
if [[ $# -ge 5 && $1 == -G && $2 == --ignore-files && $3 == --hidden && $4 == -I && $5 == --exclude-dir=.git ]]; then
  tool=(-0 ugrep)
elif [[ $# -ge 4 && $1 == -S && $2 == dfs && $3 == -regextype && $4 == findutils-default ]]; then
  tool=(-0 bfs)
fi
exec "$root/tools/qemu/usr/bin/qemu-x86_64" -cpu max "${tool[@]}" "$root/downloads/claude-$version" "$@"
